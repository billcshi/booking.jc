# Dependencies and package-manager state
/node_modules/
/.pnp/
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# Build, test, and generated output
/.next/
/out/
/build/
/coverage/
*.tsbuildinfo
next-env.d.ts

# Runtime data and backups (may contain guest information)
/data/
/backups/
*.db
*.db-*
*.sqlite
*.sqlite3
*.dump

# Environment files and credentials
.env*
!.env.example
.npmrc
.netrc
credentials*.json
secrets*.json
*.pem
*.key
*.p12
*.pfx

# Local tooling and editor state
/.vercel/
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs and diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
